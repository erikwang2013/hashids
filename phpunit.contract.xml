<?xml version="1.0" encoding="UTF-8"?>
<!--
  契约测试专用配置：只在安装了真实框架包的 vendor 下运行。

  与 phpunit.xml.dist 的差别只有两处：
    1. bootstrap 换成 tests/Contract/bootstrap.php（会校验真框架符号存在）
    2. 只跑 tests/Contract

  主矩阵（phpunit.xml.dist）已经把 tests/Contract 排除在外 —— 因为真框架包要求
  PHP >= 8.1/8.2，装不进 `php: ^8.0` 的矩阵。
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Contract/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="contract">
            <directory>tests/Contract</directory>
            <!-- Laravel 单独跑：它与 Webman 都定义全局 base_path()，不能同 vendor。
                 见 tests/Contract/Laravel/bootstrap.php 与 phpunit.contract-laravel.xml。 -->
            <exclude>tests/Contract/Laravel</exclude>
        </testsuite>
    </testsuites>
</phpunit>
